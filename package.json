{
  "name": "hojin-blog",
  "version": "0.4.0",
  "private": true,
  "description": "Personal blog built as runtime micro-frontends — TanStack Start host, Vite React remotes, Lit contract",
  "keywords": [
    "blog",
    "markdown",
    "tanstack-start",
    "module-federation",
    "lit",
    "tailwindcss"
  ],
  "homepage": "https://github.com/hovelopin/blog",
  "bugs": {
    "url": "https://github.com/hovelopin/blog/issues"
  },
  "license": "MIT",
  "author": "hovelopin",
  "repository": {
    "type": "git",
    "url": "https://github.com/hovelopin/blog.git"
  },
  "scripts": {
    "dev": "pnpm --filter @blog/start dev",
    "dev:remotes": "pnpm --filter @blog/remotes dev",
    "build": "pnpm --filter @blog/remotes build && pnpm --filter @blog/start build",
    "preview": "pnpm --filter @blog/start preview",
    "preview:remotes": "pnpm --filter @blog/remotes preview",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "import:docx": "node scripts/import-docx.mjs",
    "previews": "node scripts/capture-link-previews.mjs"
  },
  "devDependencies": {
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "pnpm@8.15.6"
}
