{
  "name": "hojin-blog",
  "version": "0.3.1",
  "private": true,
  "description": "Personal blog built with Next.js — posts, research notes, and diary written in Markdown",
  "keywords": [
    "blog",
    "markdown",
    "nextjs",
    "shadcn-ui",
    "tailwindcss"
  ],
  "homepage": "https://github.com/hovelopin/blog",
  "bugs": {
    "url": "https://github.com/hovelopin/blog/issues"
  },
  "license": "MIT",
  "author": "hovelopin",
  "repository": {
    "type": "git",
    "url": "https://github.com/hovelopin/blog.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "import:docx": "node scripts/import-docx.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@upstash/redis": "^1.38.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.6.0",
    "next": "16.2.1",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reading-time": "^1.5.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-cjk-friendly": "^2.0.1",
    "remark-flexible-markers": "^1.3.4",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn": "^4.1.0",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
